# 복사: cp .env.example .env  후 값 채우기 (.env 는 Git 에 커밋하지 마세요)

#--------------------------------------------------------------------
# 앱 환경 & 공개 URL (둘 다 .env 에서 다룸 — CI_ENVIRONMENT 만으로 URL은 안 바뀜)
#--------------------------------------------------------------------
# development | production | testing
CI_ENVIRONMENT = development

# 브라우저 주소창과 맞추세요. site_url(), OAuth 리다이렉트, canonical 등에 사용됩니다.
# 로컬 예:
# app.baseURL = http://localhost:8080/
# 운영 예:
# app.baseURL = https://pongpongkorea.co.kr/

# 로컬에서 HTTP만 쓸 때 HTTPS 로 강제 리다이렉트되면 끄기:
# app.forceGlobalSecureRequests = false

#--------------------------------------------------------------------
# Naver Cloud Platform - Maps (Dynamic Map JS ncpKeyId + Geocoding REST)
# 콘솔 Application Key: Client ID → NAVER_MAPS_API_KEY_ID
#                       Client Secret → NAVER_MAPS_API_KEY
#--------------------------------------------------------------------
NAVER_MAPS_API_KEY_ID=
NAVER_MAPS_API_KEY=

#--------------------------------------------------------------------
# Database (app/Config/Database.php 가 .env 에서 읽음)
#--------------------------------------------------------------------
# database.default.hostname = localhost
# database.default.database = ...
# database.default.username = ...
# database.default.password = ...
